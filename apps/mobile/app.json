{
  "expo": {
    "name": "Majestor",
    "slug": "majestor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/majestor-logo.png",
    "scheme": "majestor",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.majestor.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/majestor-icon-foreground.png",
        "backgroundImage": "./assets/images/majestor-icon-background.png",
        "monochromeImage": "./assets/images/majestor-icon-foreground.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAdOgPKLCStwuWE2jh11xirJdMz_C5ycYY"
        }
      },
      "edgeToEdgeEnabled": true,
      "package": "com.majestor.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/majestor-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyAdOgPKLCStwuWE2jh11xirJdMz_C5ycYY"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Majestor to access gallery."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Majestor to use your location."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "ei_abdullah",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8fa870d9-3fb8-4c04-94a9-4f1eec3471fb"
      }
    }
  }
}
