    {
      "id": "yZ81K64_ip733UJTfFizX",
      "type": "text",
      "x": -1062.7420974572715,
      "y": 6644.440627442837,
      "width": 4337.57177734375,
      "height": 1830.0000000000055,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bEW",
      "roundness": null,
      "seed": 614338050,
      "version": 1978,
      "versionNonce": 1238572325,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1767882107798,
      "link": null,
      "locked": false,
      "text": "A Ride Booker will post his ride(where he wants to go) and it will be queued to availableRides\nA Rider  will also post a ride(where he wants to go) where he is going and it will be queued to availableRides\n\nCar/Bike will he held into consideration. If car, then limit of 5 to bookedRides queue and if a bike, then 2\n\nRide Bookers will be shown the rides posted by the Riders and then they will subscribe to bookedRides\n\nBoth rides will be compared and will calculate showing how much the ride booker is off to the route of rider, \nrendered on maps and rates will be calculated accordingly\n\nIf the anyone cancels the ride, he will be dequeued from the BookedRide\nIf the rider cancels the ride, the entire BookedRide will be deleted\n\nIf the riders, starts, the Ride will be removed from availbleRides but will remain in BookedRide\n\nRoles of RideBooker or Rider will play an important part\n\nMessages will be a group message/individual message (will see)",
      "fontSize": 81.33333333333357,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A Ride Booker will post his ride(where he wants to go) and it will be queued to availableRides\nA Rider  will also post a ride(where he wants to go) where he is going and it will be queued to availableRides\n\nCar/Bike will he held into consideration. If car, then limit of 5 to bookedRides queue and if a bike, then 2\n\nRide Bookers will be shown the rides posted by the Riders and then they will subscribe to bookedRides\n\nBoth rides will be compared and will calculate showing how much the ride booker is off to the route of rider, \nrendered on maps and rates will be calculated accordingly\n\nIf the anyone cancels the ride, he will be dequeued from the BookedRide\nIf the rider cancels the ride, the entire BookedRide will be deleted\n\nIf the riders, starts, the Ride will be removed from availbleRides but will remain in BookedRide\n\nRoles of RideBooker or Rider will play an important part\n\nMessages will be a group message/individual message (will see)",
      "autoResize": true,
      "lineHeight": 1.25
    },
